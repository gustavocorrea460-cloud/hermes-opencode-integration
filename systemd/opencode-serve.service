[Unit]
Description=OpenCode Serve — LLM Inference Engine for Hermes
Documentation=https://opencode.ai
After=network.target

[Service]
Type=simple
ExecStart=%h/.opencode/bin/opencode serve --port 8800 --hostname 127.0.0.1
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.opencode %h/.config/opencode

[Install]
WantedBy=default.target
